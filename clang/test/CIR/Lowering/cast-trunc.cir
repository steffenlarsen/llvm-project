// RUN: cir-opt %s -cir-to-llvm -o %t.cir
// RUN: FileCheck %s --input-file=%t.cir

// Verify that unrealized_conversion_cast from a wider integer to a narrower
// integer is lowered to llvm.trunc during CIR-to-LLVM conversion.  This
// pattern arises when AMDGPU builtins produce i64 values that need to be
// truncated to i32 for downstream use.

!u64i = !cir.int<u, 64>
!u32i = !cir.int<u, 32>

module {
  // CHECK-LABEL: llvm.func @trunc_i64_to_i32
  cir.func @trunc_i64_to_i32(%arg0: !u64i) -> !u32i {
    // The unrealized_conversion_cast from i64 → i32 should become llvm.trunc.
    %0 = builtin.unrealized_conversion_cast %arg0 : !u64i to i32

    // CHECK: llvm.trunc %{{.*}} : i64 to i32
    %1 = builtin.unrealized_conversion_cast %0 : i32 to !u32i
    cir.return %1 : !u32i
  }

  // Verify that the existing narrow→wide (zext) path still works.
  // CHECK-LABEL: llvm.func @zext_i32_to_i64
  cir.func @zext_i32_to_i64(%arg0: !u32i) -> !u64i {
    %0 = builtin.unrealized_conversion_cast %arg0 : !u32i to i64

    // CHECK: llvm.zext %{{.*}} : i32 to i64
    %1 = builtin.unrealized_conversion_cast %0 : i64 to !u64i
    cir.return %1 : !u64i
  }
}
