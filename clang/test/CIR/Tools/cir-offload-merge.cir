// REORDER: module attributes {cir.offload.container} {
// REORDER-NEXT: module @host
// REORDER: module @device_cuda_nvptx64_nvidia_cuda__sm_90
// REORDER: module @device_cuda_nvptx64_nvidia_cuda__sm_80

