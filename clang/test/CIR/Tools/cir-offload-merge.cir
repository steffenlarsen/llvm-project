// SPLIT-SM90: module @device_cuda_nvptx64_nvidia_cuda__sm_90 attributes {cir.offload.bundle_id = "cuda-nvptx64-nvidia-cuda--sm_90", cir.offload.kind = #cir.offload<device>} {

