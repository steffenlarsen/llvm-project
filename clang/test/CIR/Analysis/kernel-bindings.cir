// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir.offload.container(test-print-kernel-bindings))" \
// RUN:   2>&1 | FileCheck %s

// One host stub resolving to one device kernel.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z5scalePff() {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff
// CHECK-NEXT: <no launch site>

// -----

// Same kernel present in two device modules (multi-arch).
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z5scalePff() {
        cir.return
      }
    }
    builtin.module @device_1 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z5scalePff() {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff
// CHECK-NEXT: device @device_1 : @_Z5scalePff
// CHECK-NEXT: <no launch site>

// -----

// Host stub whose kernel is absent from every device module.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z19__device_stub__deadv() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z4deadv">} {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z4deadv
// CHECK-NEXT: host-stub @_Z19__device_stub__deadv
// CHECK-NEXT: <no device kernel>
// CHECK-NEXT: <no launch site>

// -----

// Near-empty host module (a non-stub helper, no cu.kernel_name) with a
// device-only kernel: nothing binds, table is empty.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @host_helper() {
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z6devfunv() {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 0 empty true

// -----

// Two launches of the same kernel, from different host functions.
!s32i = !cir.int<s, 32>
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @_Z18__device_stub__bari(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z3bari">} {
        cir.return
      }
      cir.func @launch_a() {
        %0 = cir.const #cir.int<7> : !s32i
        cir.call @_Z18__device_stub__bari(%0) {cu.kernel_name = #cir.cu.kernel_name<"_Z3bari">} : (!s32i) -> ()
        cir.return
      }
      cir.func @launch_b(%arg0: !s32i) {
        cir.call @_Z18__device_stub__bari(%arg0) {cu.kernel_name = #cir.cu.kernel_name<"_Z3bari">} : (!s32i) -> ()
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @_Z3bari(%arg0: !s32i) {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z3bari
// CHECK-NEXT: host-stub @_Z18__device_stub__bari
// CHECK-NEXT: device @device_0 : @_Z3bari
// CHECK-NEXT: launch in @launch_a : 1 args
// CHECK-NEXT: launch in @launch_b : 1 args

// -----

!s32i = !cir.int<s, 32>

// A launch site naming a kernel with no host stub in this container is not
// recorded: a binding without a stub would have no host side to describe.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func @caller() {
        %0 = cir.const #cir.int<1> : !s32i
        cir.call @not_a_stub(%0) {cu.kernel_name = #cir.cu.kernel_name<"absent">} : (!s32i) -> ()
        cir.return
      }
      cir.func private @not_a_stub(!s32i)
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 0 empty true

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// A launch in the shape CIRGen emits: the geometry is reachable from the
// push-call-configuration call guarding the stub call.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
      cir.func internal private @stub_geo(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_geo">} {
        cir.return
      }
      cir.func @launch_geo() {
        %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
        %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
        %one = cir.const #cir.int<1> : !u32i
        cir.call @dim3_ctor(%grid, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        cir.call @dim3_ctor(%block, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        %shmem = cir.const #cir.int<0> : !u32i
        %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
        %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
        %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
        %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
        cir.if %c {
        } else {
          %v = cir.const #cir.int<7> : !s32i
          cir.call @stub_geo(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_geo">} : (!s32i) -> ()
        }
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_geo(%arg0: !s32i) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel kern_geo
// CHECK-NEXT: host-stub @stub_geo
// CHECK-NEXT: device @device_0 : @kern_geo
// CHECK-NEXT: launch in @launch_geo : 1 args, grid const, block const, stream default

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// The call filling the dim3 temporary is identified by its cxx_ctor marker, so
// an unrelated function with a matching signature does not supply geometry.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      cir.func private @not_a_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i)
      cir.func internal private @stub_nc(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_nc">} {
        cir.return
      }
      cir.func @launch_nc() {
        %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
        %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
        %one = cir.const #cir.int<1> : !u32i
        cir.call @not_a_ctor(%grid, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        cir.call @not_a_ctor(%block, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        %shmem = cir.const #cir.int<0> : !u32i
        %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
        %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
        %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
        %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
        cir.if %c {
        } else {
          %v = cir.const #cir.int<7> : !s32i
          cir.call @stub_nc(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_nc">} : (!s32i) -> ()
        }
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_nc(%arg0: !s32i) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel kern_nc
// CHECK-NEXT: host-stub @stub_nc
// CHECK-NEXT: device @device_0 : @kern_nc
// CHECK-NEXT: launch in @launch_nc : 1 args, grid untraced, block untraced, stream default

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// A dimension built from a runtime value is traced, but is not constant. This
// is distinct from a dimension that could not be traced at all.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
      cir.func internal private @stub_dyn(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_dyn">} {
        cir.return
      }
      cir.func @launch_dyn(%n: !u32i) {
        %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
        %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
        %one = cir.const #cir.int<1> : !u32i
        cir.call @dim3_ctor(%grid, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        cir.call @dim3_ctor(%block, %n, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        %shmem = cir.const #cir.int<0> : !u32i
        %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
        %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
        %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
        %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
        cir.if %c {
        } else {
          %v = cir.const #cir.int<7> : !s32i
          cir.call @stub_dyn(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_dyn">} : (!s32i) -> ()
        }
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_dyn(%arg0: !s32i) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// CHECK: kernel kern_dyn
// CHECK-NEXT: host-stub @stub_dyn
// CHECK-NEXT: device @device_0 : @kern_dyn
// CHECK-NEXT: launch in @launch_dyn : 1 args, grid const, block dynamic, stream default

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// Once the CFG is flattened the guarding cir.if is gone -- the branch remains,
// as blocks -- and the push call can no longer be reached from the launch, so
// no geometry is reported.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
      cir.func internal private @stub_flat(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_flat">} {
        cir.return
      }
      cir.func @launch_flat() {
        %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
        %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
        %one = cir.const #cir.int<1> : !u32i
        cir.call @dim3_ctor(%grid, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        cir.call @dim3_ctor(%block, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        %shmem = cir.const #cir.int<0> : !u32i
        %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
        %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
        %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
        %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
        cir.brcond %c ^bb1, ^bb2
      ^bb1:
        cir.br ^bb3
      ^bb2:
        %v = cir.const #cir.int<7> : !s32i
        cir.call @stub_flat(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_flat">} : (!s32i) -> ()
        cir.br ^bb3
      ^bb3:
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_flat(%arg0: !s32i) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// CHECK: kernel kern_flat
// CHECK-NEXT: host-stub @stub_flat
// CHECK-NEXT: device @device_0 : @kern_flat
// CHECK-NEXT: launch in @launch_flat : 1 args, <no geometry>

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// A constant stream that is not the null pointer is not the default stream.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
      cir.func internal private @stub_stream(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_stream">} {
        cir.return
      }
      cir.func @launch_stream() {
        %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
        %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
        %one = cir.const #cir.int<1> : !u32i
        cir.call @dim3_ctor(%grid, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        cir.call @dim3_ctor(%block, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        %shmem = cir.const #cir.int<0> : !u32i
        %stream = cir.const #cir.ptr<4660 : i64> : !cir.ptr<!s32i>
        %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
        %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
        %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
        %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
        cir.if %c {
        } else {
          %v = cir.const #cir.int<7> : !s32i
          cir.call @stub_stream(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_stream">} : (!s32i) -> ()
        }
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_stream(%arg0: !s32i) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

// CHECK: kernel kern_stream
// CHECK-NEXT: host-stub @stub_stream
// CHECK-NEXT: device @device_0 : @kern_stream
// CHECK-NEXT: launch in @launch_stream : 1 args, grid const, block const, stream explicit

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!u64i = !cir.int<u, 64>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>
!rec_anon_struct = !cir.struct<{data !u64i, data !u32i}>

// The shape CIRGen actually emits for HIP: the target ABI coerces each dim3
// into an {i64, i32} pair, so the push call takes six operands rather than
// four and each dim3 has to be recovered through the scratch slot it was
// stored into. The geometry is the same launch either way.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.func private @__hipPushCallConfiguration(!u64i, !u32i, !u64i, !u32i, !u64i, !cir.ptr<!s32i>) -> !u32i
      cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
      cir.func internal private @stub_coerced(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_coerced">} {
        cir.return
      }
      cir.func @launch_coerced() {
        %gridTmp = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
        %blockTmp = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
        %gridCoerce = cir.alloca "coerce" align(8) : !cir.ptr<!rec_anon_struct>
        %blockCoerce = cir.alloca "coerce" align(8) : !cir.ptr<!rec_anon_struct>
        %one = cir.const #cir.int<1> : !u32i
        %c8 = cir.const #cir.int<8> : !u32i
        %c256 = cir.const #cir.int<256> : !u32i
        cir.call @dim3_ctor(%gridTmp, %c8, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        cir.call @dim3_ctor(%blockTmp, %c256, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        %grid = cir.load align(4) %gridTmp : !cir.ptr<!rec_dim3>, !rec_dim3
        %block = cir.load align(4) %blockTmp : !cir.ptr<!rec_dim3>, !rec_dim3
        %gridSlot = cir.cast bitcast %gridCoerce : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!rec_dim3>
        cir.store %grid, %gridSlot : !rec_dim3, !cir.ptr<!rec_dim3>
        %gm0 = cir.get_member %gridCoerce[0] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u64i>
        %glo = cir.load %gm0 : !cir.ptr<!u64i>, !u64i
        %gm1 = cir.get_member %gridCoerce[1] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u32i>
        %ghi = cir.load %gm1 : !cir.ptr<!u32i>, !u32i
        %blockSlot = cir.cast bitcast %blockCoerce : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!rec_dim3>
        cir.store %block, %blockSlot : !rec_dim3, !cir.ptr<!rec_dim3>
        %bm0 = cir.get_member %blockCoerce[0] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u64i>
        %blo = cir.load %bm0 : !cir.ptr<!u64i>, !u64i
        %bm1 = cir.get_member %blockCoerce[1] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u32i>
        %bhi = cir.load %bm1 : !cir.ptr<!u32i>, !u32i
        %shmem = cir.const #cir.int<0> : !u64i
        %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        %r = cir.call @__hipPushCallConfiguration(%glo, %ghi, %blo, %bhi, %shmem, %stream) : (!u64i, !u32i, !u64i, !u32i, !u64i, !cir.ptr<!s32i>) -> !u32i
        %c = cir.cast int_to_bool %r : !u32i -> !cir.bool
        cir.if %c {
        } else {
          %v = cir.const #cir.int<7> : !s32i
          cir.call @stub_coerced(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_coerced">} : (!s32i) -> ()
        }
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func @kern_coerced(%arg0: !s32i) cc(ptx_kernel) {
        cir.return
      }
    }
  }
}

