// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(test-print-kernel-bindings)" \
// RUN:   2>&1 | FileCheck %s

// One host stub resolving to one device kernel.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z5scalePff() {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff
// CHECK-NEXT: <no launch site>

// -----

// Same kernel present in two device modules (multi-arch).
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func @_Z20__device_stub__scalePff() attributes {cu.kernel_name = #cir.cu.kernel_name<"_Z5scalePff">} {
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z5scalePff() {
      cir.return
    }
  }
  module @device_1 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @_Z5scalePff() {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel _Z5scalePff
// CHECK-NEXT: host-stub @_Z20__device_stub__scalePff
// CHECK-NEXT: device @device_0 : @_Z5scalePff

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// The same launch with dim3's constructor already inlined: the slots are filled
// field by field instead of by a constructor call, and the geometry is still
// recoverable.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
    cir.func internal private @stub_geo_inlined(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_geo_inlined">} {
      cir.return
    }
    cir.func @launch_geo_inlined() {
      %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
      %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
      %one = cir.const #cir.int<1> : !u32i
      %width = cir.const #cir.int<32> : !u32i
      %gx = cir.get_member %grid[0] {name = "x"} : !cir.ptr<!rec_dim3> -> !cir.ptr<!u32i>
      cir.store align(4) %one, %gx : !u32i, !cir.ptr<!u32i>
      %gy = cir.get_member %grid[1] {name = "y"} : !cir.ptr<!rec_dim3> -> !cir.ptr<!u32i>
      cir.store align(4) %one, %gy : !u32i, !cir.ptr<!u32i>
      %gz = cir.get_member %grid[2] {name = "z"} : !cir.ptr<!rec_dim3> -> !cir.ptr<!u32i>
      cir.store align(4) %one, %gz : !u32i, !cir.ptr<!u32i>
      %bx = cir.get_member %block[0] {name = "x"} : !cir.ptr<!rec_dim3> -> !cir.ptr<!u32i>
      cir.store align(4) %width, %bx : !u32i, !cir.ptr<!u32i>
      %by = cir.get_member %block[1] {name = "y"} : !cir.ptr<!rec_dim3> -> !cir.ptr<!u32i>
      cir.store align(4) %one, %by : !u32i, !cir.ptr<!u32i>
      %bz = cir.get_member %block[2] {name = "z"} : !cir.ptr<!rec_dim3> -> !cir.ptr<!u32i>
      cir.store align(4) %one, %bz : !u32i, !cir.ptr<!u32i>
      %shmem = cir.const #cir.int<0> : !u32i
      %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
      %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
      %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
      %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
      cir.if %c {
      } else {
        %v = cir.const #cir.int<7> : !s32i
        cir.call @stub_geo_inlined(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_geo_inlined">} : (!s32i) -> ()
      }
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @kern_geo_inlined(%arg0: !s32i) cc(ptx_kernel) {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel kern_geo_inlined
// CHECK-NEXT: host-stub @stub_geo_inlined
// CHECK-NEXT: device @device_0 : @kern_geo_inlined
// CHECK-NEXT: launch in @launch_geo_inlined : 1 args, grid const, block const, stream default

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!u64i = !cir.int<u, 64>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>
!rec_anon_struct = !cir.struct<{data !u64i, data !u32i}>

// CallConvLowering Direct+canFlatten: each dim3 is stored into a {i64,i32}
// coerce slot and the push call takes the fields. Geometry is the record
// stored into that slot, not the packed integers.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @__cudaPushCallConfiguration(!u64i, !u32i, !u64i, !u32i, !u64i, !cir.ptr<!s32i>) -> !s32i
    cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
    cir.func internal private @stub_abi(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_abi">} {
      cir.return
    }
    cir.func @launch_abi() {
      %cb = cir.alloca "coerce" align(8) : !cir.ptr<!rec_anon_struct>
      %cg = cir.alloca "coerce" align(8) : !cir.ptr<!rec_anon_struct>
      %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
      %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
      %one = cir.const #cir.int<1> : !u32i
      cir.call @dim3_ctor(%grid, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      cir.call @dim3_ctor(%block, %one, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      %sh = cir.const #cir.int<0> : !u64i
      %st = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
      %gv = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
      %bv = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
      %cgd = cir.cast bitcast %cg : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!rec_dim3>
      cir.store %gv, %cgd : !rec_dim3, !cir.ptr<!rec_dim3>
      %gxy.p = cir.get_member %cg[0] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u64i>
      %gxy = cir.load %gxy.p : !cir.ptr<!u64i>, !u64i
      %gz.p = cir.get_member %cg[1] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u32i>
      %gz = cir.load %gz.p : !cir.ptr<!u32i>, !u32i
      %cbd = cir.cast bitcast %cb : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!rec_dim3>
      cir.store %bv, %cbd : !rec_dim3, !cir.ptr<!rec_dim3>
      %bxy.p = cir.get_member %cb[0] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u64i>
      %bxy = cir.load %bxy.p : !cir.ptr<!u64i>, !u64i
      %bz.p = cir.get_member %cb[1] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u32i>
      %bz = cir.load %bz.p : !cir.ptr<!u32i>, !u32i
      %r = cir.call @__cudaPushCallConfiguration(%gxy, %gz, %bxy, %bz, %sh, %st) : (!u64i, !u32i, !u64i, !u32i, !u64i, !cir.ptr<!s32i>) -> !s32i
      %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
      cir.if %c {
      } else {
        %v = cir.const #cir.int<7> : !s32i
        cir.call @stub_abi(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_abi">} : (!s32i) -> ()
      }
      %r_mixed = cir.call @__cudaPushCallConfiguration(%gxy, %bz, %bxy, %bz, %sh, %st) : (!u64i, !u32i, !u64i, !u32i, !u64i, !cir.ptr<!s32i>) -> !s32i
      %c_mixed = cir.cast int_to_bool %r_mixed : !s32i -> !cir.bool
      cir.if %c_mixed {
      } else {
        %v = cir.const #cir.int<8> : !s32i
        cir.call @stub_abi(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_abi">} : (!s32i) -> ()
      }
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @kern_abi(%arg0: !s32i) cc(ptx_kernel) {
      cir.return
    }
  }
}

// CHECK: kernel kern_abi
// CHECK-NEXT: host-stub @stub_abi
// CHECK-NEXT: device @device_0 : @kern_abi
// CHECK-NEXT: launch in @launch_abi : 1 args, grid const, block const, stream default
// CHECK-NEXT: launch in @launch_abi : 1 args, grid untraced, block const, stream default

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!u64i = !cir.int<u, 64>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>
!rec_anon_struct = !cir.struct<{data !u64i, data !u32i}>

// The shape CIRGen actually emits for HIP: the target ABI coerces each dim3
// into an {i64, i32} pair, so the push call takes six operands rather than
// four and each dim3 has to be recovered through the scratch slot it was
// stored into. The geometry is the same launch either way.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.func private @__hipPushCallConfiguration(!u64i, !u32i, !u64i, !u32i, !u64i, !cir.ptr<!s32i>) -> !u32i
    cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
    cir.func internal private @stub_coerced(%arg0: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_coerced">} {
      cir.return
    }
    cir.func @launch_coerced() {
      %gridTmp = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
      %blockTmp = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
      %gridCoerce = cir.alloca "coerce" align(8) : !cir.ptr<!rec_anon_struct>
      %blockCoerce = cir.alloca "coerce" align(8) : !cir.ptr<!rec_anon_struct>
      %one = cir.const #cir.int<1> : !u32i
      %c8 = cir.const #cir.int<8> : !u32i
      %c256 = cir.const #cir.int<256> : !u32i
      cir.call @dim3_ctor(%gridTmp, %c8, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      cir.call @dim3_ctor(%blockTmp, %c256, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      %grid = cir.load align(4) %gridTmp : !cir.ptr<!rec_dim3>, !rec_dim3
      %block = cir.load align(4) %blockTmp : !cir.ptr<!rec_dim3>, !rec_dim3
      %gridSlot = cir.cast bitcast %gridCoerce : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!rec_dim3>
      cir.store %grid, %gridSlot : !rec_dim3, !cir.ptr<!rec_dim3>
      %gm0 = cir.get_member %gridCoerce[0] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u64i>
      %glo = cir.load %gm0 : !cir.ptr<!u64i>, !u64i
      %gm1 = cir.get_member %gridCoerce[1] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u32i>
      %ghi = cir.load %gm1 : !cir.ptr<!u32i>, !u32i
      %blockSlot = cir.cast bitcast %blockCoerce : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!rec_dim3>
      cir.store %block, %blockSlot : !rec_dim3, !cir.ptr<!rec_dim3>
      %bm0 = cir.get_member %blockCoerce[0] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u64i>
      %blo = cir.load %bm0 : !cir.ptr<!u64i>, !u64i
      %bm1 = cir.get_member %blockCoerce[1] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!u32i>
      %bhi = cir.load %bm1 : !cir.ptr<!u32i>, !u32i
      %shmem = cir.const #cir.int<0> : !u64i
      %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
      %r = cir.call @__hipPushCallConfiguration(%glo, %ghi, %blo, %bhi, %shmem, %stream) : (!u64i, !u32i, !u64i, !u32i, !u64i, !cir.ptr<!s32i>) -> !u32i
      %c = cir.cast int_to_bool %r : !u32i -> !cir.bool
      cir.if %c {
      } else {
        %v = cir.const #cir.int<7> : !s32i
        cir.call @stub_coerced(%v) {cu.kernel_name = #cir.cu.kernel_name<"kern_coerced">} : (!s32i) -> ()
      }
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func @kern_coerced(%arg0: !s32i) cc(ptx_kernel) {
      cir.return
    }
  }
}

// CHECK: KernelBindingTable
// CHECK-NEXT: size 1 empty false
// CHECK-NEXT: kernel kern_coerced
// CHECK-NEXT: host-stub @stub_coerced
// CHECK-NEXT: device @device_0 : @kern_coerced
// CHECK-NEXT: launch in @launch_coerced : 1 args, grid const, block const, stream default
