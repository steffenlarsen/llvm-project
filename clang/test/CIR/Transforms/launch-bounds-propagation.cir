!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// Every launch of an AMDGPU kernel is visible -- an internal stub with no
// handle global -- so the maximum is narrowed in place and no clone is made.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
