// Tests for the offload EliminateCoveredGuards pass.
//
// A kernel carries a tail guard -- `if (index >= n) return;` -- for the threads
// of a partially populated last block. The largest index is computed in the
// launch dimensions, and each launch dispatches to a copy with the guard folded
// away when, for its own grid and block size, that largest index is below n.

// RUN: cir-opt %s -split-input-file \
// RUN:   -pass-pipeline="builtin.module(cir-offload-eliminate-covered-guards)" \
// RUN:   | FileCheck %s

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// grid = ceil(n/256) with 256 threads, index = blockDim.x*blockIdx.x +
// threadIdx.x. max(index) = 256*(n/256 - 1) + 255 = n - 1, so `index >= n` is
// dead whenever 256 divides n.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global external @kern_basic = #cir.global_view<@stub_basic> : !cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>
    cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
    cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
    cir.func internal private @stub_basic(%p: !cir.ptr<!s32i>, %n: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_basic">} {
      %h = cir.get_global @kern_basic : !cir.ptr<!cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>>
      cir.return
    }
    cir.func @launch_basic(%p: !cir.ptr<!s32i>, %n: !s32i) {
      %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
      %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
      %one = cir.const #cir.int<1> : !u32i
      %bs = cir.const #cir.int<256> : !u32i
      %nu = cir.cast integral %n : !s32i -> !u32i
      %dm1 = cir.const #cir.int<255> : !u32i
      %dv = cir.const #cir.int<256> : !u32i
      %sum = cir.add %nu, %dm1 : !u32i
      %blocks = cir.div %sum, %dv : !u32i
      cir.call @dim3_ctor(%grid, %blocks, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      cir.call @dim3_ctor(%block, %bs, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      %shmem = cir.const #cir.int<0> : !u32i
      %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
      %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
      %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
      %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
      cir.if %c {
      } else {
        cir.call @stub_basic(%p, %n) {cu.kernel_name = #cir.cu.kernel_name<"kern_basic">} : (!cir.ptr<!s32i>, !s32i) -> ()
      }
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @_ZN24__hip_builtin_blockIdx_t7__get_xEv() -> !u32i
    cir.func private @_ZN24__hip_builtin_blockDim_t7__get_xEv() -> !u32i
    cir.func private @_ZN25__hip_builtin_threadIdx_t7__get_xEv() -> !u32i
    cir.func @kern_basic(%arg0: !cir.ptr<!s32i>, %arg1: !s32i) cc(ptx_kernel) {
      %bid = cir.call @_ZN24__hip_builtin_blockIdx_t7__get_xEv() : () -> !u32i
      %bdim = cir.call @_ZN24__hip_builtin_blockDim_t7__get_xEv() : () -> !u32i
      %tid = cir.call @_ZN25__hip_builtin_threadIdx_t7__get_xEv() : () -> !u32i
      %mul = cir.mul %bid, %bdim : !u32i
      %idxu = cir.add %mul, %tid : !u32i
      %idx = cir.cast integral %idxu : !u32i -> !s32i
      %g = cir.cmp ge %idx, %arg1 : !s32i
      cir.if %g {
        cir.return
      }
      cir.return
    }
  }
}


// The launch picks between the two copies on (G-1)*B + (B-1) < n, the largest
// index for its grid G and block B -- with G = ceil(n/256) and B = 256 that is
// n % 256 == 0 -- and on that index fitting the int it is converted to.
// CHECK-LABEL: cir.func @launch_basic
// CHECK:         %[[G:.*]] = cir.cast integral %[[GRID:.*]] : !u32i -> !s64i
// CHECK:         %[[B:.*]] = cir.cast integral %[[BLOCK:.*]] : !u32i -> !s64i
// CHECK:         %[[ONE:.*]] = cir.const #cir.int<1> : !s64i
// CHECK:         %[[BM:.*]] = cir.sub %[[G]], %[[ONE]] : !s64i
// CHECK:         %[[TM:.*]] = cir.sub %[[B]], %[[ONE]] : !s64i
// CHECK:         %[[N:.*]] = cir.cast integral %arg1 : !s32i -> !s64i
// CHECK:         %[[PROD:.*]] = cir.mul %[[BM]], %[[B]] : !s64i
// CHECK:         %[[MAX:.*]] = cir.add %[[PROD]], %[[TM]] : !s64i
// CHECK:         %[[BELOW:.*]] = cir.cmp lt %[[MAX]], %[[N]] : !s64i
// CHECK:         %[[INTMAX:.*]] = cir.const #cir.int<2147483647> : !s64i
// CHECK:         %[[FITS:.*]] = cir.cmp le %[[MAX]], %[[INTMAX]] : !s64i
// CHECK:         %[[PREMISE:.*]] = cir.ternary(%[[BELOW]], true {
// CHECK-NEXT:      cir.yield %[[FITS]]
// CHECK:         cir.if %[[PREMISE]] {
// CHECK:           cir.call @stub_basic.guards({{.*}}) {cu.kernel_name = #cir.cu.kernel_name<"kern_basic.guards">}
// CHECK:         } else {
// CHECK:           cir.call @stub_basic({{.*}}) {cu.kernel_name = #cir.cu.kernel_name<"kern_basic">}

// The original keeps its guard, for every n the dispatch sends to it.
// CHECK-LABEL: cir.func @kern_basic(
// CHECK:         cir.cmp ge

// The copy has the guard folded to false.
// CHECK-LABEL: cir.func @kern_basic.guards(
// CHECK-NOT:     cir.cmp ge
// CHECK:         %[[F:.*]] = cir.const #false
// CHECK:         cir.if %[[F]]

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// The grid covers n in steps of 64 but each block runs 256 threads, so the
// largest index overshoots n for every n > 0. The guard is checked rather than
// derived, so the copy is still made, but the launch only reaches it when its
// premise holds -- for this launch, never with any thread to run.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global external @kern_over = #cir.global_view<@stub_over> : !cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>
    cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
    cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
    cir.func internal private @stub_over(%p: !cir.ptr<!s32i>, %n: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_over">} {
      %h = cir.get_global @kern_over : !cir.ptr<!cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>>
      cir.return
    }
    cir.func @launch_over(%p: !cir.ptr<!s32i>, %n: !s32i) {
      %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
      %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
      %one = cir.const #cir.int<1> : !u32i
      %bs = cir.const #cir.int<256> : !u32i
      %nu = cir.cast integral %n : !s32i -> !u32i
      %dm1 = cir.const #cir.int<63> : !u32i
      %dv = cir.const #cir.int<64> : !u32i
      %sum = cir.add %nu, %dm1 : !u32i
      %blocks = cir.div %sum, %dv : !u32i
      cir.call @dim3_ctor(%grid, %blocks, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      cir.call @dim3_ctor(%block, %bs, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      %shmem = cir.const #cir.int<0> : !u32i
      %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
      %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
      %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
      %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
      cir.if %c {
      } else {
        cir.call @stub_over(%p, %n) {cu.kernel_name = #cir.cu.kernel_name<"kern_over">} : (!cir.ptr<!s32i>, !s32i) -> ()
      }
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @_ZN24__hip_builtin_blockIdx_t7__get_xEv() -> !u32i
    cir.func private @_ZN24__hip_builtin_blockDim_t7__get_xEv() -> !u32i
    cir.func private @_ZN25__hip_builtin_threadIdx_t7__get_xEv() -> !u32i
    cir.func @kern_over(%arg0: !cir.ptr<!s32i>, %arg1: !s32i) cc(ptx_kernel) {
      %bid = cir.call @_ZN24__hip_builtin_blockIdx_t7__get_xEv() : () -> !u32i
      %bdim = cir.call @_ZN24__hip_builtin_blockDim_t7__get_xEv() : () -> !u32i
      %tid = cir.call @_ZN25__hip_builtin_threadIdx_t7__get_xEv() : () -> !u32i
      %mul = cir.mul %bid, %bdim : !u32i
      %idxu = cir.add %mul, %tid : !u32i
      %idx = cir.cast integral %idxu : !u32i -> !s32i
      %g = cir.cmp ge %idx, %arg1 : !s32i
      cir.if %g {
        cir.return
      }
      cir.return
    }
  }
}


// CHECK-LABEL: cir.func @launch_over
// CHECK:         cir.cmp lt
// CHECK:           cir.call @stub_over.guards(
// CHECK:           cir.call @stub_over(
// CHECK-LABEL: cir.func @kern_over(
// CHECK:         cir.cmp ge

// -----

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// The index comes out of memory, so no bound can be computed for it and the
// guard stays.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global external @kern_mem = #cir.global_view<@stub_mem> : !cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>
    cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
    cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
    cir.func internal private @stub_mem(%p: !cir.ptr<!s32i>, %n: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_mem">} {
      %h = cir.get_global @kern_mem : !cir.ptr<!cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>>
      cir.return
    }
    cir.func @launch_mem(%p: !cir.ptr<!s32i>, %n: !s32i) {
      %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
      %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
      %one = cir.const #cir.int<1> : !u32i
      %bs = cir.const #cir.int<256> : !u32i
      %nu = cir.cast integral %n : !s32i -> !u32i
      %dm1 = cir.const #cir.int<255> : !u32i
      %dv = cir.const #cir.int<256> : !u32i
      %sum = cir.add %nu, %dm1 : !u32i
      %blocks = cir.div %sum, %dv : !u32i
      cir.call @dim3_ctor(%grid, %blocks, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      cir.call @dim3_ctor(%block, %bs, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      %shmem = cir.const #cir.int<0> : !u32i
      %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
      %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
      %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
      %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
      cir.if %c {
      } else {
        cir.call @stub_mem(%p, %n) {cu.kernel_name = #cir.cu.kernel_name<"kern_mem">} : (!cir.ptr<!s32i>, !s32i) -> ()
      }
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @_ZN24__hip_builtin_blockIdx_t7__get_xEv() -> !u32i
    cir.func private @_ZN24__hip_builtin_blockDim_t7__get_xEv() -> !u32i
    cir.func private @_ZN25__hip_builtin_threadIdx_t7__get_xEv() -> !u32i
    cir.func @kern_mem(%arg0: !cir.ptr<!s32i>, %arg1: !s32i) cc(ptx_kernel) {
      %idx = cir.load %arg0 : !cir.ptr<!s32i>, !s32i
      %g = cir.cmp ge %idx, %arg1 : !s32i
      cir.if %g {
        cir.return
      }
      cir.return
    }
  }
}


// CHECK-LABEL: cir.func @kern_mem(
// CHECK:         cir.cmp ge
// CHECK-NOT:   cir.func @kern_mem.guards

