// rocHPCG's grid, (n-1)/256 + 1. The premise does not care how the grid was
// computed: the largest index is evaluated with the launch's own grid.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global external @kern_hpcg = #cir.global_view<@stub_hpcg> : !cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>
