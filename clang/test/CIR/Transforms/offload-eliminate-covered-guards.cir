!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// The guard counts in different units from the grid: the extent is `n*2` and
// the index carries the same factor. The scale has to divide the block stride
// for the runtime extent to be exact, and here 2*256/1 does.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.global external @kern_scaled = #cir.global_view<@stub_scaled> : !cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>
      cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
      cir.func internal private @stub_scaled(%p: !cir.ptr<!s32i>, %n: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_scaled">} {
        %h = cir.get_global @kern_scaled : !cir.ptr<!cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>>
        cir.return
      }
