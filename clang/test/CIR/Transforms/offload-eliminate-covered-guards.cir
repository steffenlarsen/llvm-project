!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// The stride is written as a literal rather than as blockDim.x. Both spellings
// have to be recognised: ggml uses the literal form in one kernel and the
// blockDim.x form in another.
module {
  cir.offload.container {
    builtin.module @host attributes {cir.offload.kind = #cir.offload_kind<host>} {
      cir.global external @kern_lit = #cir.global_view<@stub_lit> : !cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>
      cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
      cir.func internal private @stub_lit(%p: !cir.ptr<!s32i>, %n: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_lit">} {
        %h = cir.get_global @kern_lit : !cir.ptr<!cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>>
        cir.return
      }
      cir.func @launch_lit(%p: !cir.ptr<!s32i>, %n: !s32i) {
        %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
        %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
        %one = cir.const #cir.int<1> : !u32i
        %bs = cir.const #cir.int<128> : !u32i
        %nu = cir.cast integral %n : !s32i -> !u32i
        %dm1 = cir.const #cir.int<127> : !u32i
        %dv = cir.const #cir.int<128> : !u32i
        %sum = cir.add %nu, %dm1 : !u32i
        %blocks = cir.div %sum, %dv : !u32i
        cir.call @dim3_ctor(%grid, %blocks, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        cir.call @dim3_ctor(%block, %bs, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
        %shmem = cir.const #cir.int<0> : !u32i
        %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
        %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
        %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
        %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
        %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
        cir.if %c {
        } else {
          cir.call @stub_lit(%p, %n) {cu.kernel_name = #cir.cu.kernel_name<"kern_lit">} : (!cir.ptr<!s32i>, !s32i) -> ()
        }
        cir.return
      }
    }
    builtin.module @device_0 attributes {cir.offload.kind = #cir.offload_kind<device>} {
      cir.func private @_ZN24__hip_builtin_blockIdx_t7__get_xEv() -> !u32i
      cir.func private @_ZN24__hip_builtin_blockDim_t7__get_xEv() -> !u32i
      cir.func private @_ZN25__hip_builtin_threadIdx_t7__get_xEv() -> !u32i
      cir.func @kern_lit(%arg0: !cir.ptr<!s32i>, %arg1: !s32i) cc(ptx_kernel) {
        %bid = cir.call @_ZN24__hip_builtin_blockIdx_t7__get_xEv() : () -> !u32i
        %tid = cir.call @_ZN25__hip_builtin_threadIdx_t7__get_xEv() : () -> !u32i
        %c128 = cir.const #cir.int<128> : !u32i
        %mul = cir.mul %bid, %c128 : !u32i
        %idxu = cir.add %mul, %tid : !u32i
        %idx = cir.cast integral %idxu : !u32i -> !s32i
        %g = cir.cmp ge %idx, %arg1 : !s32i
        cir.if %g {
          cir.return
        }
        cir.return
      }
    }
  }
}


// CHECK-LABEL: cir.func @kern_lit.guards(
// CHECK-NOT:     cir.cmp ge
// CHECK:         %[[F:.*]] = cir.const #false

