!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!rec_dim3 = !cir.struct<"dim3" {data !u32i, data !u32i, data !u32i}>

// The grid is a constant unrelated to any kernel argument. The premise does not
// need a relation between the two: the largest index is a constant, and the
// guard is dead exactly when n exceeds it.
module attributes {cir.offload.container} {
  module @host attributes {cir.offload.kind = #cir.offload<host>} {
    cir.global external @kern_unrel = #cir.global_view<@stub_unrel> : !cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>
    cir.func private @__cudaPushCallConfiguration(!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
    cir.func private @dim3_ctor(!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) func_info<#cir.cxx_ctor<!rec_dim3, custom>>
    cir.func internal private @stub_unrel(%p: !cir.ptr<!s32i>, %n: !s32i) attributes {cu.kernel_name = #cir.cu.kernel_name<"kern_unrel">} {
      %h = cir.get_global @kern_unrel : !cir.ptr<!cir.ptr<!cir.func<(!cir.ptr<!s32i>, !s32i)>>>
      cir.return
    }
    cir.func @launch_unrel(%p: !cir.ptr<!s32i>, %n: !s32i) {
      %grid = cir.alloca "agg.tmp0" align(4) : !cir.ptr<!rec_dim3>
      %block = cir.alloca "agg.tmp1" align(4) : !cir.ptr<!rec_dim3>
      %one = cir.const #cir.int<1> : !u32i
      %bs = cir.const #cir.int<256> : !u32i
      %blocks = cir.const #cir.int<7> : !u32i
      cir.call @dim3_ctor(%grid, %blocks, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      cir.call @dim3_ctor(%block, %bs, %one, %one) : (!cir.ptr<!rec_dim3>, !u32i, !u32i, !u32i) -> ()
      %shmem = cir.const #cir.int<0> : !u32i
      %stream = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
      %g = cir.load %grid : !cir.ptr<!rec_dim3>, !rec_dim3
      %b = cir.load %block : !cir.ptr<!rec_dim3>, !rec_dim3
      %r = cir.call @__cudaPushCallConfiguration(%g, %b, %shmem, %stream) : (!rec_dim3, !rec_dim3, !u32i, !cir.ptr<!s32i>) -> !s32i
      %c = cir.cast int_to_bool %r : !s32i -> !cir.bool
      cir.if %c {
      } else {
        cir.call @stub_unrel(%p, %n) {cu.kernel_name = #cir.cu.kernel_name<"kern_unrel">} : (!cir.ptr<!s32i>, !s32i) -> ()
      }
      cir.return
    }
  }
  module @device_0 attributes {cir.offload.kind = #cir.offload<device>} {
    cir.func private @_ZN24__hip_builtin_blockIdx_t7__get_xEv() -> !u32i
    cir.func private @_ZN24__hip_builtin_blockDim_t7__get_xEv() -> !u32i
    cir.func private @_ZN25__hip_builtin_threadIdx_t7__get_xEv() -> !u32i
    cir.func @kern_unrel(%arg0: !cir.ptr<!s32i>, %arg1: !s32i) cc(ptx_kernel) {
      %bid = cir.call @_ZN24__hip_builtin_blockIdx_t7__get_xEv() : () -> !u32i
      %bdim = cir.call @_ZN24__hip_builtin_blockDim_t7__get_xEv() : () -> !u32i
      %tid = cir.call @_ZN25__hip_builtin_threadIdx_t7__get_xEv() : () -> !u32i
      %mul = cir.mul %bid, %bdim : !u32i
      %idxu = cir.add %mul, %tid : !u32i
      %idx = cir.cast integral %idxu : !u32i -> !s32i
      %g = cir.cmp ge %idx, %arg1 : !s32i
      cir.if %g {
        cir.return
      }
      cir.return
    }
  }
}


// CHECK-LABEL: cir.func @launch_unrel
// CHECK:         cir.cmp lt
// CHECK:           cir.call @stub_unrel.guards(
// CHECK-LABEL: cir.func @kern_unrel(
// CHECK:         cir.cmp ge
// CHECK-LABEL: cir.func @kern_unrel.guards(
// CHECK-NOT:     cir.cmp ge
// CHECK:         cir.const #false

