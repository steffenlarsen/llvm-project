// Tests for CIR offload SpecializeScalarArgs pass.
//
// The pass resolves scalar (non-pointer) kernel operands at all launch sites.
// When every site passes the same compile-time constant, a specialised clone
// is created with that constant RAUW'd into the body.

// RUN: cir-opt --split-input-file --cir-offload-specialize-scalar-args %s \
// RUN:   | FileCheck %s

!u32i = !cir.int<u, 32>
!s32i = !cir.int<s, 32>

//===----------------------------------------------------------------------===//
// 1. Two launches pass the same constant scalar -> one clone with RAUW'd arg;
//    both launches redirected; original preserved.
//===----------------------------------------------------------------------===//

// CHECK:      cir.offload.kernel_launch @offload_device_module::@k$scalarspec
// CHECK:      cir.offload.kernel_launch @offload_device_module::@k$scalarspec
// CHECK:      cir.offload.func @k(
// CHECK-NOT:  cir.const
// CHECK:      cir.offload.func @k$scalarspec(
// CHECK:        cir.const #cir.int<784>

module {
  cir.func @host1(%n: !u32i) {
    %c1 = cir.const #cir.int<1> : !u32i
    %c256 = cir.const #cir.int<256> : !u32i
    %val = "cir.const"() <{value = #cir.int<784> : !s32i}> : () -> !s32i

    cir.offload.kernel_launch @offload_device_module::@k
        grid(%n, %c1, %c1 : !u32i)
        block(%c256, %c1, %c1 : !u32i)
        args(%val : !s32i)
    cir.return
  }

  cir.func @host2(%n: !u32i) {
    %c1 = cir.const #cir.int<1> : !u32i
    %c256 = cir.const #cir.int<256> : !u32i
    %val = "cir.const"() <{value = #cir.int<784> : !s32i}> : () -> !s32i

    cir.offload.kernel_launch @offload_device_module::@k
        grid(%n, %c1, %c1 : !u32i)
        block(%c256, %c1, %c1 : !u32i)
        args(%val : !s32i)
    cir.return
  }

  cir.offload.module @offload_device_module {
    cir.offload.func @k(%n: !s32i) kernel {
      cir.return
    }
  }
}

// -----

!u32i = !cir.int<u, 32>
!s32i = !cir.int<s, 32>

//===----------------------------------------------------------------------===//
// 2. Sites disagree -> one specialization each, rather than none.
//
// Giving up when two sites disagree loses the constant at both.  A kernel
// reached through more than one fixed-shape caller is the normal case, so each
// group of agreeing sites gets its own kernel and is redirected to it.
//===----------------------------------------------------------------------===//

// CHECK:      cir.offload.kernel_launch
// CHECK-SAME: @k_disagree$scalarspec_0v784
// CHECK:      cir.offload.kernel_launch
// CHECK-SAME: @k_disagree$scalarspec_0v1024
// CHECK-DAG:  cir.offload.func @k_disagree(
// CHECK-DAG:  cir.offload.func @k_disagree$scalarspec_0v784(
// CHECK-DAG:  cir.offload.func @k_disagree$scalarspec_0v1024(

module {
  cir.func @host1(%n: !u32i) {
    %c1 = cir.const #cir.int<1> : !u32i
    %c256 = cir.const #cir.int<256> : !u32i
    %val = "cir.const"() <{value = #cir.int<784> : !s32i}> : () -> !s32i

    cir.offload.kernel_launch @offload_device_module::@k_disagree
        grid(%n, %c1, %c1 : !u32i)
        block(%c256, %c1, %c1 : !u32i)
        args(%val : !s32i)
    cir.return
  }

  cir.func @host2(%n: !u32i) {
    %c1 = cir.const #cir.int<1> : !u32i
    %c256 = cir.const #cir.int<256> : !u32i
    %val = "cir.const"() <{value = #cir.int<1024> : !s32i}> : () -> !s32i

    cir.offload.kernel_launch @offload_device_module::@k_disagree
        grid(%n, %c1, %c1 : !u32i)
        block(%c256, %c1, %c1 : !u32i)
        args(%val : !s32i)
    cir.return
  }

  cir.offload.module @offload_device_module {
    cir.offload.func @k_disagree(%n: !s32i) kernel {
      cir.return
    }
  }
}

// -----

!u32i = !cir.int<u, 32>
!s32i = !cir.int<s, 32>

//===----------------------------------------------------------------------===//
// 3. Alloca has one direct store but its address escapes (passed to a call)
//    -> no specialization.  Regression test for a miscompile where
//    `int size = -1; parseIt(&size);` was wrongly resolved to -1.
//===----------------------------------------------------------------------===//

// CHECK:      cir.offload.kernel_launch @offload_device_module::@k_escape
// CHECK-NOT:  $scalarspec
// CHECK:      cir.offload.func @k_escape(
// CHECK-NOT:  $scalarspec

module {
  cir.func private @parse_size(!cir.ptr<!s32i>) -> !s32i

  cir.func @host_escape() {
    %c1 = cir.const #cir.int<1> : !u32i
    %c256 = cir.const #cir.int<256> : !u32i

    // int size = -1;
    %size_alloca = "cir.alloca"() <{alignment = 4 : i64, name = "size"}> : () -> !cir.ptr<!s32i>
    %neg1 = cir.const #cir.int<-1> : !s32i
    cir.store %neg1, %size_alloca : !s32i, !cir.ptr<!s32i>

    // parse_size(&size) — address escapes, may overwrite *size.
    %ret = cir.call @parse_size(%size_alloca) : (!cir.ptr<!s32i>) -> !s32i

    // kernel<<<...>>>(size)
    %size_val = cir.load %size_alloca : !cir.ptr<!s32i>, !s32i
    cir.offload.kernel_launch @offload_device_module::@k_escape
        grid(%c1, %c1, %c1 : !u32i)
        block(%c256, %c1, %c1 : !u32i)
        args(%size_val : !s32i)
    cir.return
  }

  cir.offload.module @offload_device_module {
    cir.offload.func @k_escape(%n: !s32i) kernel {
      cir.return
    }
  }
}
