    Any({{UniS32, S32}, {{Sgpr32}, {Sgpr32}}}, If(HasSALUFloatInsts)),
    Any({{UniS32, S32}, {{UniInVgprS32}, {Vgpr32}}}, IfNot(HasSALUFloatInsts)),
    Any({{DivS32, S32}, {{Vgpr32}, {Vgpr32}}}),
    Any({{UniS64, S32}, {{UniInVgprS64}, {Vgpr32}}}),
    Any({{DivS64, S32}, {{Vgpr64}, {Vgpr32}}}))

RULES_G(NoFastRules, (G_AMDGPU_S_BUFFER_PREFETCH),
    Any({{}, {{}, {SgprV4S32_ReadFirstLane, Imm, SgprB32_ReadFirstLane}}}))
RULES_G(NoFastRules, (G_PREFETCH),
    // Safe smem prefetch keeps both data and instruction prefetch.
    Any({{UniPtr64}, {{}, {SgprPtr64}}}, If(HasSafeSmemPrefetch)),
    // Vmem prefetch keeps data prefetch only.
    Any({{{UniPtr64}, IsDataPF}, {{}, {SgprPtr64}}}, IfNot(HasSafeSmemPrefetch) && If(HasVmemPrefInsts)),
    Any({{{UniPtr64}, IsDataPF}, {{}, {}, DeletePrefetch}}, IfNot(HasSafeSmemPrefetch) && IfNot(HasVmemPrefInsts)),
    Any({{{UniPtr64}, PRED(!IsDataPF(MI))}, {{}, {}, DeletePrefetch}}, IfNot(HasSafeSmemPrefetch)),

    Any({{{DivPtr64}, IsDataPF}, {{}, {VgprPtr64}}}, If(HasVmemPrefInsts)),
    Any({{{DivPtr64}, IsDataPF}, {{}, {}, DeletePrefetch}}, IfNot(HasVmemPrefInsts)),
    Any({{{DivPtr64}, PRED(!IsDataPF(MI))}, {{}, {}, DeletePrefetch}}),

    Any({{P3}, {{}, {}, DeletePrefetch}}),
    Any({{P5}, {{}, {}, DeletePrefetch}}),
    Any({{UniP6}, {{}, {SgprP6}}}, If(HasSafeSmemPrefetch)),
    Any({{UniP6}, {{}, {}, DeletePrefetch}}, IfNot(HasSafeSmemPrefetch)))

