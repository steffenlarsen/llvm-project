    Div(S32, {{Vgpr32}, {Vgpr32, Vgpr32, Vgpr32}}))

// TODO: This opcode is generated from the i64->i16 signed clamped pattern in
// the PreLegalizerCombiner. Move the combine to RegBankCombiner to keep more
// instructions on SALU.
RULES_G(Standard, (G_AMDGPU_SMED3),
    Uni(S32, {{UniInVgprS32}, {Vgpr32, Vgpr32, Vgpr32}}),
    Div(S32, {{Vgpr32}, {Vgpr32, Vgpr32, Vgpr32}}))

// FNEG and FABS are either folded as source modifiers or can be selected as
// bitwise XOR and AND with Mask. XOR and AND are available on SALU but for
// targets without SALU float we still select them as VGPR since there would
// be no real sgpr use.
RULES_G(Standard, (G_FNEG, G_FABS),
    Uni(S16, {{UniInVgprS16}, {Vgpr16}}, IfNot(HasSALUFloatInsts)),
    Uni(S16, {{Sgpr16}, {Sgpr16}}, If(HasSALUFloatInsts)),
    Div(S16, {{Vgpr16}, {Vgpr16}}),
    Uni(S32, {{UniInVgprS32}, {Vgpr32}}, IfNot(HasSALUFloatInsts)),
    Uni(S32, {{Sgpr32}, {Sgpr32}}, If(HasSALUFloatInsts)),
    Div(S32, {{Vgpr32}, {Vgpr32}}),
    Uni(S64, {{UniInVgprS64}, {Vgpr64}}),
    Div(S64, {{Vgpr64}, {Vgpr64}}),
    Uni(V2S16, {{SgprV2S16}, {SgprV2S16}}),
    Div(V2S16, {{VgprV2S16}, {VgprV2S16}}),
    Any({{UniV2S32}, {{UniInVgprV2S32}, {VgprV2S32}}}),
    Any({{DivV2S32}, {{VgprV2S32}, {VgprV2S32}}}))

RULES_G(Standard, (G_FCANONICALIZE),
    Uni(S32, {{UniInVgprS32}, {Vgpr32}}),
    Div(S32, {{Vgpr32}, {Vgpr32}}),
    Uni(S16, {{UniInVgprS16}, {Vgpr16}}),
    Div(S16, {{Vgpr16}, {Vgpr16}}),
    Uni(S64, {{UniInVgprS64}, {Vgpr64}}),
    Div(S64, {{Vgpr64}, {Vgpr64}}),
    Uni(V2S16, {{UniInVgprV2S16}, {VgprV2S16}}),
    Div(V2S16, {{VgprV2S16}, {VgprV2S16}}),
    Any({{UniV2S32}, {{UniInVgprV2S32}, {VgprV2S32}}}),
    Any({{DivV2S32}, {{VgprV2S32}, {VgprV2S32}}}),
    Any({{UniV2S64}, {{UniInVgprV2S64}, {VgprV2S64}}}),
    Any({{DivV2S64}, {{VgprV2S64}, {VgprV2S64}}}))
// Only 16-bit G_FSQRT operations are legal. F32/F64 is handled with a custom
// legalization in the legalizer.
RULES_G(NoFastRules, (G_FSQRT),
    Any({{DivS16}, {{Vgpr16}, {Vgpr16}}}),
    Any({{UniBF16}, {{UniInVgprS16}, {Vgpr16}}}),
    Any({{UniS16}, {{Sgpr16}, {Sgpr16}}}, If(HasPseudoScalarTrans)),
    Any({{UniS16}, {{UniInVgprS16}, {Vgpr16}}}, IfNot(HasPseudoScalarTrans)))

RULES_G(NoFastRules, (G_FPTOUI, G_FPTOSI, G_FPTOUI_SAT, G_FPTOSI_SAT),
    Any({{UniS16, S16}, {{UniInVgprS16}, {Vgpr16}}}),
    Any({{DivS16, S16}, {{Vgpr16}, {Vgpr16}}}),
    Any({{UniS32, S16}, {{Sgpr32}, {Sgpr16}}}, If(HasSALUFloatInsts)),
    Any({{UniS32, S16}, {{UniInVgprS32}, {Vgpr16}}}, IfNot(HasSALUFloatInsts)),
    Any({{DivS32, S16}, {{Vgpr32}, {Vgpr16}}}),
    Any({{UniS16, S32}, {{Sgpr16}, {Sgpr32}}}, If(HasSALUFloatInsts)),
    Any({{UniS16, S32}, {{UniInVgprS16}, {Vgpr32}}}, IfNot(HasSALUFloatInsts)),
    Any({{DivS16, S32}, {{Vgpr16}, {Vgpr32}}}),
    Any({{UniS32, S32}, {{Sgpr32}, {Sgpr32}}}, If(HasSALUFloatInsts)),
    Any({{UniS32, S32}, {{UniInVgprS32}, {Vgpr32}}}, IfNot(HasSALUFloatInsts)),
    Any({{DivS32, S32}, {{Vgpr32}, {Vgpr32}}}),
    Any({{UniS32, S64}, {{UniInVgprS32}, {Vgpr64}}}),
    Any({{DivS32, S64}, {{Vgpr32}, {Vgpr64}}}),
    Any({{UniV2S16, V2S32}, {{UniInVgprV2S16}, {SgprV2S32}}}),
    Any({{DivV2S16, V2S32}, {{VgprV2S16}, {VgprV2S32}}}))

RULES_G(NoFastRules, (G_UITOFP, G_SITOFP),
    Any({{UniS16, S16}, {{UniInVgprS16}, {Vgpr16}}}),
